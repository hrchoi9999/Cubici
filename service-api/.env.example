# Cubici local PostgreSQL connection template.
# Copy this file to the repository root as .env. Docker and FastAPI share it.
# Set a real local-only password and never commit .env.

CUBICI_ENV=local
CUBICI_DB_HOST=127.0.0.1
CUBICI_DB_PORT=55432
CUBICI_DB_NAME=cubici_local
CUBICI_DB_USER=cubici_app
CUBICI_DB_PASSWORD=change-me-local-only
CUBICI_DB_SCHEMA=public

# External integrations stay disabled in local migration development.
CUBICI_EXTERNAL_API_ENABLED=false
CUBICI_PAYMENT_ENABLED=false
CUBICI_SMS_ENABLED=false
CUBICI_MAIL_ENABLED=false
