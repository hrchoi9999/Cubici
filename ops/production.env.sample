# Copy to D:\Alt_CSM\Cubici\.env.production.local and set real secrets.
# Do not commit real production env files.

CUBICI_DB_NAME=cubici_prod
CUBICI_DB_USER=cubici_app
CUBICI_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
CUBICI_DB_SCHEMA=public
CUBICI_DB_PUBLIC_PORT=55432

CUBICI_API_PUBLIC_PORT=8000
CUBICI_AUTH_SECRET=CHANGE_ME_AUTH_SECRET
CUBICI_MASTER_ADMIN_EMAIL=admin@example.com
VITE_CUBICI_MASTER_ADMIN_EMAIL=admin@example.com
CUBICI_CORS_ALLOW_ORIGINS=https://admin.example.com,https://app.example.com
CUBICI_CORS_ALLOW_ORIGIN_REGEX=

CUBICI_EXTERNAL_API_ENABLED=false
CUBICI_PAYMENT_ENABLED=false
CUBICI_SMS_ENABLED=false
CUBICI_MAIL_ENABLED=false

# Cloudflare Dashboard > Zero Trust > Networks > Tunnels에서 발급한 token.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_CLOUDFLARE_TUNNEL_TOKEN
