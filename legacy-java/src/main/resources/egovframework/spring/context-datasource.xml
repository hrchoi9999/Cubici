<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:jdbc="http://www.springframework.org/schema/jdbc"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
        http://www.springframework.org/schema/jdbc  http://www.springframework.org/schema/jdbc/spring-jdbc-4.0.xsd">

    <!-- Mysql-->
    <bean id="parentDataSource" class="org.apache.commons.dbcp2.BasicDataSource" destroy-method="close">
        <property name="driverClassName" value="${db.driverClassName}"/>
        <property name="url" value="${db.url}" />
        <property name="username" value="${db.username}"/>
        <property name="password" value="${db.password}"/>
        <property name="maxTotal" value="100" />
        <property name="maxIdle" value="10" />
        <property name="maxWaitMillis" value="-1"/>
        <property name="defaultAutoCommit" value="true"/>
        <property name="validationQuery" value="select 1"/>
        <property name="testWhileIdle" value="true"/>
        <property name="timeBetweenEvictionRunsMillis" value="3600000"/>
    </bean>
    <bean id="dataSource" class="net.sf.log4jdbc.Log4jdbcProxyDataSource">
        <constructor-arg ref="dataSourceRouting" />
        <property name="logFormatter">
            <bean class="net.sf.log4jdbc.tools.Log4JdbcCustomFormatter">
                <property name="loggingType" value="MULTI_LINE" />
                <property name="sqlPrefix" value="SQL&#58;&#58;&#58; " />
            </bean>
        </property>
    </bean>

    <bean id="dataSourceAzon" parent="parentDataSource">
        <property name="url" value="${db.url}" />
        <property name="username" value="${db.username}"/>
        <property name="password" value="${db.password}"/>
    </bean>

    <bean id="dataSourceDev" parent="parentDataSource">
        <property name="url" value="${db.url}" />
        <property name="username" value="${db.username}"/>
        <property name="password" value="${db.password}"/>
    </bean>


    <bean id="dataSourceRouting" class="egovframework.azon.cmmn.datasource.RoutingDataSource">
        <property name="targetDataSources">
            <map key-type="egovframework.azon.cmmn.datasource.DataSourceType">
                <entry key="CUBICI" value-ref="dataSourceAzon" />
                <entry key="DEV" value-ref="dataSourceDev" />
            </map>
        </property>
        <!-- Default DataSource -->
        <property name="defaultTargetDataSource" ref="dataSourceAzon" />
    </bean>

</beans>
